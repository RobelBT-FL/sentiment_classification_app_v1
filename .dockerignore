venv/
env/
.venv/

# Environment files
.env
*.env

# Node / Frontend
node_modules/
frontend-next/node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# ML Models (REMOVE models/ — backend needs it)
*.gguf
*.bin
*.pt
*.pth
*.onnx
*.h5

# Datasets (REMOVE data/ — backend needs it)
datasets/
*.csv
*.tsv
*.jsonl
*.parquet
*.zip
*.tar
*.gz

# Build artifacts
build/
dist/
*.egg-info/
*.whl

# Docker artifacts
docker-data/
*.tar

# Temporary files
*.tmp
*.bak
*.old
