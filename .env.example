# ============================================
# ENVIRONMENT VARIABLES (EXAMPLE TEMPLATE)
# DO NOT PUT REAL SECRETS HERE
# ============================================

# -----------------------------
# APP SETTINGS
# -----------------------------
APP_ENV=development          # environment: development | staging | production
APP_DEBUG=true               # enable debug mode for local development
APP_PORT=8000                # FastAPI backend port

# -----------------------------
# JWT / AUTHENTICATION
# -----------------------------
API_JWT_SECRET=CHANGE_ME     # secret used to sign JWT tokens (never commit real one)
JWT_ALGORITHM=HS256          # algorithm for JWT signing
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------
# MODEL CONFIGURATION
# -----------------------------
MODEL_PATH=./models/llama-2-7b-chat-hf-q4_k_m.gguf   # path to GGUF model
TOKENIZER_PATH=./models/tokenizer.model              # tokenizer file (if needed)
MODEL_CONTEXT_SIZE=4096                              # llama.cpp context window

# -----------------------------
# DATA CONFIGURATION
# -----------------------------
DATA_PATH=./data/imdb.csv     # dataset used for evaluation
GOLD_SAMPLE_SIZE=50           # number of samples for evaluation pipeline

# -----------------------------
# LOGGING
# -----------------------------
LOG_LEVEL=info                # logging level: debug | info | warning | error
LOG_DIR=./logs                # directory for log files

# -----------------------------
# FRONTEND CONFIG
# -----------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000   # backend URL for Next.js frontend

# -----------------------------
# DATABASE (OPTIONAL / FUTURE)
# -----------------------------
DB_URL=postgresql://user:password@localhost:5432/app_db   # example only
DB_POOL_SIZE=5

# -----------------------------
# REDIS (OPTIONAL / FUTURE)
# -----------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------
# CLOUD / DEPLOYMENT (OPTIONAL)
# -----------------------------
AZURE_STORAGE_ACCOUNT=CHANGE_ME
AZURE_STORAGE_KEY=CHANGE_ME
AZURE_CONTAINER_NAME=CHANGE_ME