# ============================================
# ENVIRONMENT VARIABLES (EXAMPLE TEMPLATE)
# DO NOT PUT REAL SECRETS HERE
# ============================================

# -----------------------------
# APP SETTINGS
# -----------------------------
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# -----------------------------
# JWT / AUTHENTICATION
# -----------------------------
API_JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------
# MODEL CONFIGURATION
# -----------------------------
MODEL_PATH=./models/llama-2-7b-chat-hf-q4_k_m.gguf
TOKENIZER_PATH=./models/tokenizer.model
MODEL_CONTEXT_SIZE=4096

# -----------------------------
# DATA CONFIGURATION
# -----------------------------
DATA_PATH=./data/imdb.csv
GOLD_SAMPLE_SIZE=50

# -----------------------------
# LOGGING
# -----------------------------
LOG_LEVEL=info
LOG_DIR=./logs

# -----------------------------
# FRONTEND CONFIG
# -----------------------------
# IMPORTANT:
# The frontend runs in the browser, not inside Docker.
# So the browser must call the backend using localhost.
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------
# DATABASE (OPTIONAL / FUTURE)
# -----------------------------
DB_URL=postgresql://user:password@postgres:5432/app_db
DB_POOL_SIZE=5

# -----------------------------
# REDIS (OPTIONAL / FUTURE)
# -----------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------
# VECTOR DATABASES
# -----------------------------
QDRANT_URL=http://qdrant:6333
CHROMA_URL=http://chromadb:8000

# -----------------------------
# CLOUD / DEPLOYMENT (OPTIONAL)
# -----------------------------
AZURE_STORAGE_ACCOUNT=CHANGE_ME
AZURE_STORAGE_KEY=CHANGE_ME
AZURE_CONTAINER_NAME=CHANGE_ME
