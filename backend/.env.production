# ============================================
# BACKEND .env.production
# ============================================

# ---- App Settings ----
APP_ENV=production
APP_DEBUG=false
APP_PORT=8000

# ---- JWT / Auth ----
API_JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Model Configuration ----
MODEL_PATH=/app/models/llama-2-7b-chat-hf-q4_k_m.gguf
TOKENIZER_PATH=/app/models/tokenizer.model
MODEL_CONTEXT_SIZE=4096

# ---- Data Configuration ----
DATA_PATH=/app/data/imdb.csv
GOLD_SAMPLE_SIZE=50

# ---- Logging ----
LOG_LEVEL=info
LOG_DIR=/app/logs

# ---- Frontend API URL ----
NEXT_PUBLIC_API_URL=https://your-domain.com

# ---- Vector DBs ----
QDRANT_URL=http://qdrant:6333
CHROMA_URL=http://chromadb:8000

# ---- Cloud Storage ----
AZURE_STORAGE_ACCOUNT=CHANGE_ME
AZURE_STORAGE_KEY=CHANGE_ME
AZURE_CONTAINER_NAME=CHANGE_ME
