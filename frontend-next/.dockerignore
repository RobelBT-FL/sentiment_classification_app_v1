# ============================================
# FRONTEND .dockerignore (Next.js)
# ============================================

# OS / Editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Node / Build Artifacts
node_modules/
.next/
out/
dist/

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# Environment files (optional)
.env.local
.env.development.local
.env.production.local
.env.test.local

# Misc
*.swp
*.tmp
*.bak
*.old

# DO NOT IGNORE THESE:
# package.json
# package-lock.json
# tailwind.config.js
# postcss.config.js
# next.config.mjs

